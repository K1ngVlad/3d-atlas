{
  "name": "quiz-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand prisma-quiz.store.int-spec",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.4.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
