{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Yarp": "Information" } },
  "AllowedHosts": "*",
  "Service": { "Name": "gateway" },
  "ReverseProxy": {
    "Routes": {
      "catalog": { "ClusterId": "catalog", "Order": 1, "Match": { "Path": "/api/catalog/{**rest}" } },
      "quiz": { "ClusterId": "quiz", "Order": 1, "Match": { "Path": "/api/quiz/{**rest}" } },
      "analytics": { "ClusterId": "analytics", "Order": 1, "Match": { "Path": "/api/analytics/{**rest}" } },
      "models": { "ClusterId": "minio", "Order": 1, "Match": { "Path": "/models/{**rest}" } },
      "web": { "ClusterId": "web", "Order": 1000, "Match": { "Path": "/{**rest}" } }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "Metadata": { "Consul": "true" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" } },
        "Destinations": {}
      },
      "quiz": {
        "LoadBalancingPolicy": "RoundRobin",
        "Metadata": { "Consul": "true" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" } },
        "Destinations": {}
      },
      "analytics": {
        "LoadBalancingPolicy": "RoundRobin",
        "Metadata": { "Consul": "true" },
        "HealthCheck": { "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" } },
        "Destinations": {}
      },
      "minio": { "Destinations": { "minio": { "Address": "http://minio:9000" } } },
      "web": { "Destinations": { "web": { "Address": "http://web:80" } } }
    }
  }
}
