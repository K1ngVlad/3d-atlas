# Copy to deploy/.env. Only base secrets live here; connection strings are built in docker-compose.yml.
POSTGRES_PASSWORD=change-me-postgres
CATALOG_DB_PASSWORD=change-me-catalog
QUIZ_DB_PASSWORD=change-me-quiz
ANALYTICS_DB_PASSWORD=change-me-analytics
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=change-me-rabbit
MINIO_ROOT_USER=atlas-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Optional: host port for PostgreSQL (default 5432). Use 5433 if a local PostgreSQL already runs.
# POSTGRES_HOST_PORT=5433
